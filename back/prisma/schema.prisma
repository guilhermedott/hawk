generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetType {
  computer
  notebook
  server
  switch
}

enum AssetStatus {
  online
  offline
  maintenance
}

model Asset {
  id          String      @id @default(uuid())
  tag         String
  name        String
  type        AssetType
  status      AssetStatus @default(online)
  department  String
  responsible String
  notes       String?

  // Especificações geradas na criação (imutáveis)
  os          String
  cpuModel    String
  cpuCores    Int
  totalRamGb  Int
  totalDiskGb Int
  ip          String
  macAddress  String
  bootedAt    DateTime

  // Usados só pelo gerador de métricas (deixam cada ativo com comportamento próprio)
  seed        Int
  loadFactor  Float

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([companyId, tag])
  @@index([companyId])
  @@map("assets")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  membership   Membership?
  joinRequests JoinRequest[]
  ticketsCreated  Ticket[] @relation("TicketCreator")
  ticketsAssigned Ticket[] @relation("TicketAssignee")

  @@map("users")
}

enum MemberRole {
  owner
  member
}

enum JoinRequestStatus {
  pending
  approved
  rejected
}

model Company {
  id        String   @id @default(uuid())
  name      String
  // nome normalizado (minúsculo, sem espaços repetidos) para impedir duplicatas
  nameKey   String   @unique
  createdAt DateTime @default(now())

  memberships  Membership[]
  joinRequests JoinRequest[]
  assets       Asset[]
  tickets Ticket[]

  @@map("companies")
}

model Membership {
  id        String     @id @default(uuid())
  role      MemberRole @default(member)
  // @unique: um usuário pertence a no máximo uma empresa
  userId    String     @unique
  companyId String
  createdAt DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("memberships")
}

model JoinRequest {
  id         String            @id @default(uuid())
  status     JoinRequestStatus @default(pending)
  userId     String
  companyId  String
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([userId, status])
  @@map("join_requests")
}

enum TicketPriority {
  low
  medium
  high
  critical
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  priority    TicketPriority @default(medium)
  status      TicketStatus   @default(open)

  assetId      String
  companyId    String
  createdById  String
  assignedToId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([assetId, status])
  @@map("tickets")
}
